{
  "$schema": "./apps/docs/node_modules/wrangler/config-schema.json",
  // Repo-root Wrangler config for Workers Builds (root directory = /).
  // Deploy: `npx wrangler deploy` ONLY — never `wrangler pages deploy` / --project-name.
  // Workers Assets (`assets.directory`); no pages_build_output_dir.
  // Local app-scoped deploy: cd apps/docs && pnpm cf:deploy
  // See docs/governance/docs-site.md and apps/docs/wrangler.jsonc
  "name": "kona",
  "compatibility_date": "2026-08-01",
  // Required when Workers Builds runs `npx wrangler preview` (non-production).
  "previews": {},
  "assets": {
    "directory": "./apps/docs/dist",
    "not_found_handling": "404-page"
  }
}
