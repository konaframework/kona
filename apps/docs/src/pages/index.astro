---
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const brandLight = `${base}branding/kona-banner.svg`;
const brandDark = `${base}branding/kona-banner-dark.svg`;
const logoLight = `${base}branding/kona-logo.svg`;
const logoDark = `${base}branding/kona-logo-dark.svg`;
const docsHub = `${base}docs/`;
const install = `${base}docs/guides/installation/`;
const introduction = `${base}docs/guides/introduction/`;
const routing = `${base}docs/http/routing/`;
const cadence = `${base}docs/cadence/`;
const crema = `${base}docs/crema/`;
const wire = `${base}docs/wire/`;
const grind = `${base}docs/grind/`;
const firefly = `${base}docs/firefly/`;
const github = 'https://github.com/konaframework/kona';

const routeSnippet = `app.resolve(Router::class.java)
    .get("/hello/{name}") { request ->
        Response.json(mapOf(
            "message" to greeter.greet(
                request.attributes["name"].toString()
            )
        ))
    }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kona — A web framework for the JVM</title>
    <meta
      name="description"
      content="Kona is a full-stack web framework for the JVM. Write the application in Kotlin or Java, start with one route, and follow the guides for HTTP, Cadence, Crema, Wire, grind, and Firefly."
    />
    <meta name="theme-color" content="#DF8723" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const stored =
          typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="landing" data-base={base}>
    <div class="landing__atmosphere" aria-hidden="true">
      <div class="landing__orb landing__orb--caramel"></div>
      <div class="landing__orb landing__orb--espresso"></div>
    </div>

    <header class="site-nav">
      <a class="site-nav__brand" href={base} aria-label="Kona home">
        <img class="site-nav__lockup site-nav__lockup--light" src={brandLight} width="170" height="56" alt="Kona" />
        <img class="site-nav__lockup site-nav__lockup--dark" src={brandDark} width="170" height="56" alt="" />
      </a>
      <nav class="site-nav__links" aria-label="Primary">
        <a href={docsHub}>Docs</a>
        <a href={install}>Installation</a>
        <a href="#toolkit">Guides</a>
        <a href={github} rel="noopener noreferrer">GitHub</a>
      </nav>
      <div class="site-nav__actions">
        <button
          type="button"
          class="site-nav__theme"
          data-landing-theme-toggle
          aria-label="Toggle color theme"
          title="Toggle color theme"
        >
          <svg class="site-nav__theme-icon site-nav__theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="site-nav__theme-icon site-nav__theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
        </button>
        <a class="site-nav__cta" href={install}>Get started</a>
      </div>
    </header>

    <main>
      <section class="landing__hero" aria-labelledby="landing-title">
        <div class="landing__copy">
          <p class="landing__eyebrow" data-reveal>For the JVM</p>
          <p class="landing__brand" data-reveal>
            <img class="landing__brand-img landing__brand-img--light" src={brandLight} width="300" height="99" alt="Kona" />
            <img class="landing__brand-img landing__brand-img--dark" src={brandDark} width="300" height="99" alt="" />
          </p>
          <h1 id="landing-title" data-reveal>
            A web framework for the <span class="landing__accent">whole request</span>.
          </h1>
          <p class="landing__lede" data-reveal>
            Kona is a full-stack web framework for the JVM. You write the application in Kotlin or
            Java — or both in the same project. Start with one route. Open a guide when you need
            the database, the views, or the console.
          </p>
          <div class="landing__ctas" data-reveal>
            <a class="btn btn--primary" href={install}>Get started</a>
            <a class="btn btn--ghost" href={docsHub}>Read the docs</a>
            <a class="btn btn--text" href={introduction}>Introduction</a>
          </div>
          <ul class="landing__pills" data-reveal aria-label="Documented pieces">
            <li><a href={routing}>HTTP</a></li>
            <li><a href={cadence}>Cadence</a></li>
            <li><a href={crema}>Crema</a></li>
            <li><a href={wire}>Wire</a></li>
            <li><a href={grind}>grind</a></li>
            <li><a href={firefly}>Firefly</a></li>
          </ul>
        </div>

        <div class="landing__visual" data-reveal="scale">
          <figure class="landing__panel-frame">
            <div class="landing__panel-chrome" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="landing__panel-body">
              <img class="landing__mark landing__mark--light" src={logoLight} width="96" height="96" alt="" />
              <img class="landing__mark landing__mark--dark" src={logoDark} width="96" height="96" alt="" />
              <pre class="landing__snippet"><code>{routeSnippet}</code></pre>
            </div>
            <figcaption>
              One route after boot. <a href={introduction}>The introduction</a> shows the full program in Kotlin and Java.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="landing__work" id="toolkit" aria-labelledby="toolkit-title">
        <div class="landing__work-head" data-reveal>
          <p class="landing__eyebrow">Already documented</p>
          <h2 id="toolkit-title">Open the piece you need.</h2>
          <p>Each of these has a guide. The names are Kona’s. The pages explain what they are and when they run.</p>
        </div>
        <ul class="landing__cards">
          <li data-reveal data-reveal-delay="1">
            <a class="landing__card" href={routing}>
              <h3>HTTP</h3>
              <p>The router matches a method and a path to a handler. Groups, named URLs, and controllers sit on that same request.</p>
              <span>Routing guide</span>
            </a>
          </li>
          <li data-reveal data-reveal-delay="2">
            <a class="landing__card" href={cadence}>
              <h3>Cadence</h3>
              <p>Kona’s database layer. Read and write rows through connections, a query builder, and models, and drop to SQL when you need it.</p>
              <span>Cadence overview</span>
            </a>
          </li>
          <li data-reveal data-reveal-delay="3">
            <a class="landing__card" href={crema}>
              <h3>Crema</h3>
              <p>Server-rendered views. Templates under your resources turn a data map from a controller into HTML.</p>
              <span>Crema overview</span>
            </a>
          </li>
          <li data-reveal>
            <a class="landing__card" href={wire}>
              <h3>Wire</h3>
              <p>Reactive server components. A Kotlin or Java class holds state and actions, and the browser stays in sync without a full page reload.</p>
              <span>Wire overview</span>
            </a>
          </li>
          <li data-reveal data-reveal-delay="1">
            <a class="landing__card" href={grind}>
              <h3>grind</h3>
              <p>The console inside the app. After you create a project, <code>./grind serve</code> runs it and the generators add the next class.</p>
              <span>Grind Console</span>
            </a>
          </li>
          <li data-reveal data-reveal-delay="2">
            <a class="landing__card" href={firefly}>
              <h3>Firefly</h3>
              <p>Kona’s admin panel. You describe a screen in Kotlin or Java, and the app serves each panel under its id.</p>
              <span>Firefly overview</span>
            </a>
          </li>
        </ul>
      </section>

      <section class="landing__next" aria-labelledby="next-title">
        <div class="landing__next-card" data-reveal>
          <p class="landing__eyebrow">Start here</p>
          <h2 id="next-title">Read the docs from the first route.</h2>
          <p>
            Installation is the short path: the toolchain, a new app, and a server you can hit.
            The introduction is for programmers who already know a language and HTTP — it defines
            each Kona term the first time it appears.
          </p>
          <div class="landing__ctas">
            <a class="btn btn--primary" href={install}>Installation</a>
            <a class="btn btn--ghost" href={introduction}>Introduction</a>
            <a class="btn btn--text" href={docsHub}>All guides</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <a class="site-footer__site" href={base}>konaframework.org</a>
        <nav class="site-footer__links" aria-label="Footer">
          <a href={docsHub}>Docs</a>
          <a href={github} rel="noopener noreferrer">github.com/konaframework/kona</a>
        </nav>
        <p class="site-footer__meta">Maven group <code>org.konaframework</code> · JDK 21+</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const storageKey = 'starlight-theme';
        const root = document.documentElement;
        const btn = document.querySelector('[data-landing-theme-toggle]');
        const siteBase = document.body.getAttribute('data-base') || '/';

        function preferred() {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        function loadStored() {
          const v = localStorage.getItem(storageKey);
          return v === 'light' || v === 'dark' ? v : null;
        }

        function apply(theme) {
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#DF8723' : '#C9A57B');
          if (btn) {
            const toDark = theme === 'light';
            btn.setAttribute('aria-label', toDark ? 'Switch to dark theme' : 'Switch to light theme');
            btn.title = toDark ? 'Dark mode' : 'Light mode';
          }
        }

        apply(loadStored() || preferred());

        btn?.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          localStorage.setItem(storageKey, next);
          apply(next);
        });

        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (!loadStored()) apply(preferred());
        });

        const lang = (navigator.language || 'en').toLowerCase();
        let locale = '';
        if (lang.startsWith('es')) locale = 'es';
        else if (lang.startsWith('fr')) locale = 'fr';
        else if (lang.startsWith('zh')) locale = 'zh-cn';
        if (locale) {
          root.lang = locale === 'zh-cn' ? 'zh-CN' : locale;
          const needle = siteBase + 'docs/';
          const withLocale = siteBase + locale + '/docs/';
          document.querySelectorAll('a[href]').forEach((a) => {
            const href = a.getAttribute('href');
            if (!href || href.indexOf(needle) !== 0) return;
            if (href.indexOf(withLocale) === 0) return;
            a.setAttribute('href', withLocale + href.slice(needle.length));
          });
        }

        const nodes = document.querySelectorAll('[data-reveal]');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          nodes.forEach((node) => node.classList.add('is-visible'));
        } else if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.14, rootMargin: '0px 0px -6% 0px' },
          );
          nodes.forEach((node) => observer.observe(node));
          document.querySelectorAll('.landing__hero [data-reveal]').forEach((node) => {
            requestAnimationFrame(() => node.classList.add('is-visible'));
          });
        } else {
          nodes.forEach((node) => node.classList.add('is-visible'));
        }
      })();
    </script>
  </body>
</html>
