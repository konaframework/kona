---
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const brandLight = `${base}branding/kona-banner.svg`;
const brandDark = `${base}branding/kona-banner-dark.svg`;
const docsHub = `${base}docs/`;
const install = `${base}docs/guides/installation/`;
const introduction = `${base}docs/guides/introduction/`;
const routing = `${base}docs/http/routing/`;
const extract = `${base}docs/extract/`;
const crema = `${base}docs/crema/`;
const grind = `${base}docs/grind/`;
const github = 'https://github.com/konaframework/kona';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kona — Batteries-included web framework for the JVM</title>
    <meta
      name="description"
      content="Laravel-inspired, batteries-included web framework for the JVM. Kotlin-first, Java first-class — HTTP, Extract, Crema, grind, and more in one toolkit."
    />
    <meta name="theme-color" content="#FF9A00" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Outfit:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {/* Match Starlight ThemeProvider — same key so docs + landing stay in sync. */}
    <script is:inline>
      (() => {
        const stored =
          typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="landing">
    <header class="landing-top">
      <a class="landing-top__home" href={base} aria-label="Kona home">
        <img class="landing-brand landing-brand--for-dark" src={brandDark} width="140" height="49" alt="" />
        <img class="landing-brand landing-brand--for-light" src={brandLight} width="140" height="49" alt="" />
      </a>
      <div class="landing-top__actions">
        <a class="landing-top__link" href={docsHub}>Docs</a>
        <button
          type="button"
          class="landing-theme"
          id="landing-theme-toggle"
          aria-label="Toggle color theme"
          title="Toggle color theme"
        >
          <span class="landing-theme__icon landing-theme__icon--moon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z" />
            </svg>
          </span>
          <span class="landing-theme__icon landing-theme__icon--sun" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main class="landing-main">
      <section class="landing-hero" aria-label="Kona">
        <div class="landing-hero__inner">
          <img
            class="landing-hero__brand landing-brand--for-dark"
            src={brandDark}
            width="224"
            height="79"
            alt="Kona"
          />
          <img
            class="landing-hero__brand landing-brand--for-light"
            src={brandLight}
            width="224"
            height="79"
            alt="Kona"
          />
          <h1 class="landing-hero__title">Batteries-included web apps on the JVM.</h1>
          <p class="landing-hero__lede">
            A Laravel-inspired, Kotlin-first framework with Java first-class APIs — routing, data, views,
            sessions, queues, and a CLI that scaffolds as you go. One toolkit, not a pile of plugins.
          </p>
          <div class="landing-cta">
            <a class="landing-cta__primary" href={install}>Get started</a>
            <a class="landing-cta__secondary" href={introduction}>Introduction</a>
            <a class="landing-cta__ghost" href={github} rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </section>

      <section class="landing-features" aria-labelledby="landing-features-title">
        <div class="landing-features__inner">
          <h2 id="landing-features-title" class="landing-features__title">What you get</h2>
          <p class="landing-features__lede">
            Batteries included from the first route to production. Start simple; dig deeper when you need to.
          </p>
          <ul class="landing-feature-list">
            <li class="landing-feature">
              <h3>Routes &amp; HTTP</h3>
              <p>
                Map URLs to handlers and controllers, group APIs, and name routes for URL generation.
                <a href={routing}>Routing guide</a>
              </p>
            </li>
            <li class="landing-feature">
              <h3>Extract</h3>
              <p>
                Query and persist data with a fluent API that stays close to SQL.
                <a href={extract}>Extract overview</a>
              </p>
            </li>
            <li class="landing-feature">
              <h3>Crema</h3>
              <p>
                Server-rendered views and assets that fit the same request lifecycle.
                <a href={crema}>Crema overview</a>
              </p>
            </li>
            <li class="landing-feature">
              <h3>grind</h3>
              <p>
                Scaffold controllers, serve locally, and generate the pieces you need next.
                <a href={grind}>grind CLI</a>
              </p>
            </li>
          </ul>
        </div>
      </section>

      <section class="landing-close" aria-labelledby="landing-close-title">
        <div class="landing-close__inner">
          <h2 id="landing-close-title" class="landing-close__title">Open the docs</h2>
          <p class="landing-close__lede">
            Install the toolchain, create an app, and follow the guides from first request to full stack.
          </p>
          <div class="landing-cta">
            <a class="landing-cta__primary" href={install}>Installation</a>
            <a class="landing-cta__secondary" href={docsHub}>Documentation hub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="landing-footer">
      <p>
        Maven group <code>dev.kona</code> · JDK 21+ ·
        <a href={github} rel="noopener noreferrer">konaframework/kona</a>
      </p>
    </footer>

    <script is:inline>
      (() => {
        const storageKey = 'starlight-theme';
        const root = document.documentElement;
        const btn = document.getElementById('landing-theme-toggle');

        function preferred() {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        function loadStored() {
          const v = localStorage.getItem(storageKey);
          return v === 'light' || v === 'dark' ? v : null;
        }

        function apply(theme) {
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#F0F4F8' : '#0B1622');
          if (btn) {
            btn.setAttribute(
              'aria-label',
              theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme',
            );
            btn.title = theme === 'light' ? 'Dark mode' : 'Light mode';
          }
        }

        apply(loadStored() || preferred());

        btn?.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          localStorage.setItem(storageKey, next);
          apply(next);
        });

        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (!loadStored()) apply(preferred());
        });
      })();
    </script>
  </body>
</html>
