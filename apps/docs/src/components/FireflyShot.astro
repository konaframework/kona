---
/**
 * Firefly docs screenshot. The `file` prop is the scene name
 * (`desk-panel.png`). The images on disk are the pair
 * `<name>-light.png` and `<name>-dark.png`. Both must exist.
 * The light file shows in the light theme and the dark file shows
 * in the dark theme. The alt text and the caption are the scene
 * description. A missing file becomes a placeholder that names both
 * files and does not link either one.
 */
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { Aside } from '@astrojs/starlight/components';

interface Props {
  file: string;
  description: string;
}

const { file, description } = Astro.props;

if (!/^[a-z0-9]+(?:-[a-z0-9]+)*\.png$/.test(file)) {
  throw new Error(`FireflyShot file must be a kebab-case png name, received ${JSON.stringify(file)}`);
}

const stem = file.slice(0, -'.png'.length);
if (stem.endsWith('-light') || stem.endsWith('-dark')) {
  throw new Error(
    `FireflyShot file is the scene name, such as desk-panel.png, received ${JSON.stringify(file)}`,
  );
}

const lightFile = `${stem}-light.png`;
const darkFile = `${stem}-dark.png`;
const folder = 'apps/docs/public/images/firefly';
const imageDirFromPackage = join(process.cwd(), 'public/images/firefly');
const imageDirFromSource = join(dirname(fileURLToPath(import.meta.url)), '../../public/images/firefly');

function present(name: string): boolean {
  return existsSync(join(imageDirFromPackage, name)) || existsSync(join(imageDirFromSource, name));
}

const both = present(lightFile) && present(darkFile);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const lightSrc = `${base}images/firefly/${lightFile}`;
const darkSrc = `${base}images/firefly/${darkFile}`;
---

{
  both ? (
    <figure class="firefly-shot">
      <img class="firefly-shot__img firefly-shot__img--light dark:sl-hidden" src={lightSrc} alt={description} />
      <img class="firefly-shot__img firefly-shot__img--dark light:sl-hidden" src={darkSrc} alt={description} />
      <figcaption>{description}</figcaption>
    </figure>
  ) : (
    <Aside type="note" title="Screenshot placeholder">
      <p>
        Files: <code>{lightFile}</code> and <code>{darkFile}</code>
      </p>
      <p>
        Folder: <code>{folder}/</code>
      </p>
      <p>{description}</p>
    </Aside>
  )
}
