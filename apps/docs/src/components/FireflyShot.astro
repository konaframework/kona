---
/**
 * Firefly docs screenshot. Renders public/images/firefly/<file> when that
 * PNG is on disk at build time. Otherwise a Starlight note naming the file.
 */
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { Aside } from '@astrojs/starlight/components';

interface Props {
  file: string;
  description: string;
}

const { file, description } = Astro.props;

if (!/^[a-z0-9]+(?:-[a-z0-9]+)*\.png$/.test(file)) {
  throw new Error(`FireflyShot file must be a kebab-case png name, received ${JSON.stringify(file)}`);
}

const folder = 'apps/docs/public/images/firefly';
const fromPackage = join(process.cwd(), 'public/images/firefly', file);
const fromSource = join(dirname(fileURLToPath(import.meta.url)), '../../public/images/firefly', file);
const present = existsSync(fromPackage) || existsSync(fromSource);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const src = `${base}images/firefly/${file}`;
---

{
  present ? (
    <figure class="firefly-shot">
      <img src={src} alt={description} />
      <figcaption>{description}</figcaption>
    </figure>
  ) : (
    <Aside type="note" title="Screenshot placeholder">
      <p>
        File: <code>{file}</code>
      </p>
      <p>
        Folder: <code>{folder}/</code>
      </p>
      <p>{description}</p>
    </Aside>
  )
}
