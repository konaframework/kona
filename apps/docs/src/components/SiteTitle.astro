---
/**
 * Kona lockup for the Starlight header (overrides the theme default SiteTitle).
 */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="site-title sl-flex">
  <a class="site-title-mark" href={base} aria-label="Kona">
    <img class="light:sl-hidden print:hidden" alt="Kona" src={`${base}branding/kona-banner-dark.svg`} width="168" height="59" />
    <img class="dark:sl-hidden print:block" alt="" src={`${base}branding/kona-banner.svg`} width="168" height="59" />
  </a>
</div>

<style>
  @layer starlight.core {
    .site-title {
      align-items: flex-end;
      gap: 0;
      min-width: 0;
      white-space: nowrap;
    }
    .site-title-mark {
      display: inline-flex;
      align-items: flex-end;
      text-decoration: none;
      min-width: 0;
      margin: 0;
      padding: 0;
      line-height: 0;
    }
    .site-title-mark img {
      display: block;
      height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
      width: auto;
      max-width: 10rem;
      object-fit: contain;
      object-position: 0 100%;
      margin: 0;
      padding: 0;
    }
  }
</style>
