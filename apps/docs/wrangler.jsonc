{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Workers + static assets → https://docs.konaframework.org
  // GitHub check: "Workers Builds: kona"
  //
  // Dashboard → Settings → Builds (Framework preset: None):
  //   Root directory:   /
  //   Build command:    pnpm install --frozen-lockfile && pnpm docs:build
  //   Deploy command:   npx wrangler deploy
  //                     (reads repo-root wrangler.jsonc → apps/docs/dist)
  //   NEVER:            npx wrangler pages deploy … --project-name=kona
  //                     (Pages API → auth 10000 on this Workers project)
  //   Preview command:  npx wrangler preview
  //                     (requires "previews": {} in wrangler.jsonc)
  //   Build vars:       PUBLIC_SITE_URL=https://docs.konaframework.org
  //                     PUBLIC_BASE_PATH=/
  //                     NODE_VERSION=22
  //                     PNPM_VERSION=9.15.0  (optional)
  //
  // This file is for local `cd apps/docs && pnpm cf:deploy`.
  // Workers Builds uses the repo-root wrangler.jsonc (same name + assets).
  // Workers Assets only — no pages_build_output_dir.
  // See docs/governance/docs-site.md
  "name": "kona",
  "compatibility_date": "2026-08-01",
  // Required when Workers Builds runs `npx wrangler preview` (non-production).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
