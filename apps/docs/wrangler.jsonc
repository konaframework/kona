{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Workers + static assets → https://docs.konaframework.org
  // GitHub check: "Workers Builds: kona"
  //
  // Dashboard → Settings → Builds (Framework preset: None):
  //   Root directory:   /
  //   Build command:    pnpm install --frozen-lockfile && pnpm docs:build
  //   Deploy command:   npx wrangler deploy --config apps/docs/wrangler.jsonc
  //   Preview command:  npx wrangler deploy --config apps/docs/wrangler.jsonc
  //   Build vars:       PUBLIC_SITE_URL=https://docs.konaframework.org
  //                     PUBLIC_BASE_PATH=/
  //                     NODE_VERSION=22
  //                     PNPM_VERSION=9.15.0  (optional)
  //
  // This is a static Astro site on Workers Assets — use `wrangler deploy`,
  // NOT `wrangler pages deploy`. Do NOT set pages_build_output_dir.
  // See docs/governance/docs-site.md
  "name": "kona",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
