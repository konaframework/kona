---
/**
 * Brew lockup for the Starlight header.
 */
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="site-title sl-flex">
  <a class="site-title-brand" href={base} aria-label="Brew">
    <img class="light:sl-hidden print:hidden" alt="Brew" src={`${base}branding/brew-banner-dark.svg`} width="124" height="60" />
    <img class="dark:sl-hidden print:block" alt="" src={`${base}branding/brew-banner.svg`} width="124" height="60" />
  </a>
</div>

<style>
  @layer starlight.core {
    .site-title {
      align-items: flex-end;
      gap: 0;
      min-width: 0;
      white-space: nowrap;
    }
    .site-title-brand {
      display: inline-flex;
      align-items: flex-end;
      text-decoration: none;
      min-width: 0;
      margin: 0;
      padding: 0;
      line-height: 0;
    }
    .site-title-brand img {
      display: block;
      height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
      width: auto;
      max-width: 10rem;
      object-fit: contain;
      object-position: 0 100%;
      margin: 0;
      padding: 0;
    }
  }
</style>
